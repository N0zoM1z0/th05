; One monochrome 32x32 cel occupies 128 contiguous bytes.
CHEETO_W equ 32
CHEETO_H equ 32
BYTE_BITS equ 8
WORD_BITS equ 16
CHEETO_ROW_BYTES equ (CHEETO_W / BYTE_BITS)
CHEETO_ROW_WORDS equ (CHEETO_ROW_BYTES / 2)
CHEETO_CEL_SHIFT equ 7
CHEETO_CEL_BYTES equ (CHEETO_ROW_BYTES * CHEETO_H)
CHEETO_CELS equ 16
CHEETO_BANK_BYTES equ (CHEETO_CEL_BYTES * CHEETO_CELS)
VRAM_HEIGHT equ 400
VRAM_ROW_BYTES equ 80
VRAM_PLANE_BYTES equ (VRAM_HEIGHT * VRAM_ROW_BYTES)
if (1 shl CHEETO_CEL_SHIFT) ne CHEETO_CEL_BYTES
 .err
endif
