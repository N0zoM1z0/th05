; Complete score records: eight little-endian decimal bytes, digit0=continues.
SCORE_DIGITS equ 8
SCORE_RECORD_BYTES equ SCORE_DIGITS
HUD_SCORE_ROW_BYTES equ (SCORE_DIGITS + 1)
SCORE_DIGIT_GLYPH equ 0a0h
HUD_SCORE_COLUMN equ 56
HUD_HISCORE_ROW equ 4
HUD_SCORE_ROW equ 6
HUD_SCORE_ROW_STEP equ (HUD_SCORE_ROW - HUD_HISCORE_ROW)
HUD_SCORE_WHITE equ 0e1h
SCORE_DELTA_SHIFT equ 5
SCORE_DELTA_DIVISIONS equ 4
SCORE_DIVISOR_BYTES equ 2
SCORE_POPUP_HISCORE equ 0
