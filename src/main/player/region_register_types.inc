; Native TH05 player state field offsets and gameplay geometry.
PLAYER_H equ 48
PLAYER_W equ 32
PLAYER_OPTION_H equ 16
PLAYER_PLUS_OPTIONS_W equ (16 + PLAYER_W + 16)
MISS_EXPLOSION_W equ 48
MISS_EXPLOSION_COUNT equ 8
MISS_EXPLOSION_RADIUS_VELOCITY equ (7 * 16)
MISS_EXPLOSION_ANGLE_VELOCITY equ 8
MISS_EXPLOSION_ANGLE_STEP equ (256 / (MISS_EXPLOSION_COUNT / 2))
; PLAYFIELD_TOP 16, BOTTOM 384, LEFT 32, RIGHT 416; signed subpixels.
CLIP_TOP_Y equ ((16 - MISS_EXPLOSION_W / 2) * 16)
CLIP_BOTTOM_Y equ ((384 - 8) * 16)
CLIP_LEFT_X equ ((32 - 40) * 16)
CLIP_RIGHT_X equ ((416 - MISS_EXPLOSION_W / 2) * 16)
PLAYER_POS_CUR_X equ 0
PLAYER_POS_CUR_Y equ 2
PLAYER_POS_PREV equ 4
PLAYER_POS_VEL_X equ 8
PLAYER_POS_VEL_Y equ 10
MOVEMENT_LOW_MAX equ (8 + 2)
MOVEMENT_HIGH_MASK equ 0Fh
MOVEMENT_HIGH_MAX equ 8
MOVEMENT_HIGH_CASE_OFFSET equ 11
MOVE_VALID equ 1
MOVE_NOINPUT equ 2
