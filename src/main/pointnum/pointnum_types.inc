; Complete TH05 records and foreign mask-bank geometry; no storage emitted.
POINTNUM_DIGITS equ 5
POINTNUM_WHITE_COUNT equ 200
POINTNUM_YELLOW_COUNT equ 80
POINTNUM_COUNT equ (POINTNUM_WHITE_COUNT + POINTNUM_YELLOW_COUNT)
POINTNUM_ALIVE_SLOTS equ (POINTNUM_COUNT + 1)
pointnum_t struc
 PN_flag db ?
 PN_age db ?
 PN_center_x dw ?
 PN_center_y dw ?
 PN_prev_y dw ?
 PN_width dw ?
 PN_digits db POINTNUM_DIGITS dup (?)
 PN_padding db ?
pointnum_t ends
.errnz (size pointnum_t) - 16
POINTNUM_W equ 8
POINTNUM_H equ 8
POINTNUM_GLYPHS equ 12
POINTNUM_SHIFTS equ 8
POINTNUM_MASK_ROW_BYTES equ 2
POINTNUM_SHIFT_BYTES equ (POINTNUM_H * POINTNUM_MASK_ROW_BYTES)
POINTNUM_GLYPH_BYTES equ (POINTNUM_SHIFTS * POINTNUM_SHIFT_BYTES)
POINTNUM_ASSET_BYTES equ (POINTNUM_GLYPHS * POINTNUM_GLYPH_BYTES)
PLAYFIELD_LEFT equ 32
PLAYFIELD_TOP equ 16
VRAM_HEIGHT equ 400
VRAM_ROW_BYTES equ 80
VRAM_PLANE_BYTES equ (VRAM_HEIGHT * VRAM_ROW_BYTES)
VRAM_BLUE equ 0a800h
GRCG_TILE_PORT equ 07eh
