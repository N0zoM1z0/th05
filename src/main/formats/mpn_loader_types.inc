; Semantic MPN file and tile-bank format, using the native far DOS ABI.
MPN_HEADER_BYTES equ 6
MPN_HEADER_MAX_INDEX_OFFSET equ 4
MPN_PALETTE_BYTES equ 48
MPN_TILE_PLANES equ 4
MPN_TILE_SIDE equ 16
MPN_TILE_ROW_BYTES equ (MPN_TILE_SIDE / 8)
MPN_IMAGE_BYTES equ (MPN_TILE_PLANES * MPN_TILE_SIDE * MPN_TILE_ROW_BYTES)
MPN_IMAGE_SHIFT equ 7
MPN_ARG_FILENAME equ 4
DOS_FN_OPEN_READ equ 3D00h
DOS_FN_READ equ 3Fh
DOS_FN_CLOSE equ 3Eh
.errnz MPN_IMAGE_BYTES - (1 shl MPN_IMAGE_SHIFT)
