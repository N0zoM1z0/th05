; Native half-tile visibility and PC-98 scroll geometry.
PLAYFIELD_WIDTH_PIXELS    equ 384
PLAYFIELD_HEIGHT_PIXELS   equ 368
HARDWARE_SCREEN_HEIGHT   equ 400
TILE_WIDTH_PIXELS        equ 16
TILE_HEIGHT_PIXELS       equ 16
DIRTY_ROW_HEIGHT_PIXELS  equ 8
DIRTY_ROW_COLUMNS        equ (512 / TILE_WIDTH_PIXELS)
DIRTY_ROW_COUNT          equ (HARDWARE_SCREEN_HEIGHT / DIRTY_ROW_HEIGHT_PIXELS)
DIRTY_MAP_TOTAL_BYTES    equ (DIRTY_ROW_COLUMNS * DIRTY_ROW_COUNT)
SUBPIXELS_PER_PIXEL      equ 16
